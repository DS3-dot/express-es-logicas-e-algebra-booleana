#and
x = True
y = False
print( x and y ) #result: False
'''
and:
True + True = True
True + False = False
False + True = False
False + False = False
'''
#-------------------------------------------------
#or
x = True
y = False
print( x or y ) #result: True
'''
or:
True + True = True
True + False = True
False + False = False
'''
